; ============================================================
; Fajos Central — Configuración de conexión
; Copia este archivo como "config.ini" y completa tus datos.
; No subas config.ini a Git (contiene la contraseña).
; ============================================================

[database]
host = localhost
port = 3306
user = root
password =
database = fajos_central

[server]
host = 0.0.0.0
port = 8000
debug = true
