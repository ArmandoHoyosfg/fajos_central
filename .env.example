# Copia a .env o usa config.ini (recomendado desde el launcher)

FAJOS_DB_HOST=localhost
FAJOS_DB_PORT=3306
FAJOS_DB_USER=root
FAJOS_DB_PASSWORD=
FAJOS_DB_NAME=fajos_central

FAJOS_APP_HOST=0.0.0.0
FAJOS_APP_PORT=8000
FAJOS_DEBUG=true
FAJOS_SECRET_KEY=cambia-esta-clave-en-produccion

# HTTPS (opcional)
FAJOS_FORCE_HTTPS=false
FAJOS_SSL_CERTFILE=certs/cert.pem
FAJOS_SSL_KEYFILE=certs/key.pem
